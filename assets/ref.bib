@incollection{costas2024sistemes,
  author = {Costas-Pérez, E. and Sánchez-Vidal, V. and Taberner, Pere A.},
  title = {Els sistemes de transferències de rendes i les oportunitats educatives},
  booktitle = {Anuari 2024. L'Estat de l'Educació a Catalunya},
  publisher = {Fundació Bofill},
  year = {2024},
  url = {https://fundaciobofill.cat/uploads/docs/z/a/l/rkj-07_anuari2024_-sistemes-transferencies111224.pdf},
  urllabel = {Chapter (CAT)},
  abstract = {This chapter explores the relationship between economic poverty and educational opportunities in Catalonia, as well as strategies to reverse this trend through improvements in current income transfer systems. Evidence highlights that students from economically disadvantaged families achieve poorer academic results. Drawing on data from the PISA report and other studies, it is demonstrated that a clear socioeconomic gradient exists in skills, grade repetition, and early school leaving, thus perpetuating the cycle of poverty. The study also includes a review of academic literature on the impact of family income on educational outcomes and the mechanisms that explain this link: investment in educational resources, parental involvement, and environmental and social factors. Additionally, it examines studies on the impact of both conditional and unconditional cash transfers on improving educational outcomes. Finally, the document outlines a series of recommendations to strengthen income guarantee systems in Catalonia, such as the Guaranteed Minimum Income and the Minimum Vital Income, to support vulnerable families and enhance educational opportunities.},
}

@inproceedings{laffaire2025labora,
  author = {Laffaire, M. and Rafart, J. and Sánchez-Vidal, M. and Taberner, Pere A.},
  title = {Evaluación del programa Làbora: un caso de innovación en políticas de empleo para personas en situación de vulnerabilidad},
  booktitle = {X Congreso de la Red Española de Política Social: Libro de resúmenes},
  pages = {294},
  publisher = {Universidad de La Rioja},
  year = {2025},
  url = {https://dialnet.unirioja.es/servlet/articulo?codigo=10486664},
  urllabel = {Paper (ESP)},
  abstract = {The main objective is to assess the effectiveness of the labour program "Làbora" in improving the employability and well-being of participants. To this end, a mixed-methods approach was applied, combining quantitative and qualitative analyses. In the quantitative analysis, the Propensity Score Matching technique was used to define a control group composed of individuals with similar characteristics who did not participate in the program. In addition, surveys were conducted with participants and non-participants, semi-structured interviews were carried out with program professionals, and focus groups were held with key stakeholders, such as collaborating companies and guidance teams.},
}

@inproceedings{salinas2025abandonament,
  author = {Salinas, P. and Femenias, L. and Laffaire, M. and Montemayor, P. and Taberner, Pere A.},
  title = {Què poden fer els centres de secundària per reduir l'abandonament escolar prematur? Evidència del cas de la ciutat de Barcelona},
  booktitle = {Repositori del 4t Congrés d'Economia i Empresa de Catalunya},
  publisher = {Col·legi d'Economistes de Catalunya},
  year = {2025},
  url = {https://coleconomistes.cat/MAILS/DOCS/88.Early%20leavers%20from%20education%20and%20training.pdf},
  urllabel = {Paper (CAT)},
  award = {Best communication on the Sustainability of Public Policies axis, 4th Congress of Economy and Business of Catalonia},
  abstract = {The abandonment of studies after the compulsory education period is associated with lower levels of well-being and employment, particularly among vulnerable students. This article aims to analyze the organizational, pedagogical, and resource-related factors of secondary schools that can help students continue their education beyond the compulsory stage. To do so, a database was built combining administrative records of more than 90,000 students who completed compulsory secondary education (ESO) in Barcelona between 2018 and 2024, with a detailed survey on school practices answered by 136 secondary schools in the city of Barcelona (66\% of the total). Using this information, a logistic regression analysis was conducted to identify the probability of a student not enrolling in post-compulsory studies during the two years following completion of ESO. The analysis incorporates individual student characteristics, administrative variables at the school level, and school practices reported in the questionnaire. The results indicate that school practices such as ensuring subject continuity during teacher absences, implementing daily monitoring of student attendance, and providing personalized guidance can significantly reduce the likelihood of early school leaving, regardless of the student’s socioeconomic and academic background.},
}

@inproceedings{costas2023pandemia,
  author = {Costas-Pérez, E. and Sánchez-Vidal, V. and Taberner, Pere A. and Vall-Castelló, J.},
  title = {La Pandemia Paralela: salud mental y suicidio en la infancia y la adolescencia},
  booktitle = {Actas del IX Congreso de la Red Española de Política Social. Colección Actas 1/2023. Parte 1},
  publisher = {Revista Alimara. IMAS},
  year = {2023},
  url = {https://www.repspalma2023.es/_files/_event/_85973/_editorFiles/file/libro%20de%20actas/CORRECTES/Panell%201.pdf},
  urllabel = {Paper (ESP)},
  abstract = {Garantizar la salud física y mental de niños, niñas y adolescentes es una prioridad para cualquier sociedad democrática. Este estudio examina las consecuencias de la pandemia de COVID-19 en la salud mental de este grupo de personas, cuya salud física fue menos afectada por la pandemia, pero que perdió contacto social debido al cierre de las escuelas. Para ello, se presenta una encuesta que incorpora las mismas preguntas de la Encuesta Nacional de Salud de España 2017 para comparar los cambios después de la pandemia. Las mayores contribuciones de este esfuerzo son, por un lado, el análisis del posible efecto que ha tenido la pandemia sobre los trastornos mentales y de conducta, con especial atención en los pensamientos suicidas. Por otro lado, se analiza según edad, sexo y nivel socioeconómico para identificar los potenciales factores de riesgo. Dada la importancia de contar con un sistema público que permita la detección y el acceso a la salud mental, analizamos los principales retos de nuestro sistema, proponiendo recomendaciones y buenas prácticas para garantizar que la salud mental sea accesible a toda la infancia y adolescencia.},
}

@inproceedings{sanchezvidal2023pobreza,
  author = {Sánchez-Vidal, V. and Sanchis-Guarner, R. and Taberner, Pere A.},
  title = {Propuesta de un indicador de pobreza absoluta local para el diseño de las rentas mínimas y prestaciones económicas},
  booktitle = {Actas del IX Congreso de la Red Española de Política Social. Colección Actas 1/2023. Parte 4},
  publisher = {Revista Alimara. IMAS},
  year = {2023},
  url = {https://www.repspalma2023.es/_files/_event/_85973/_editorFiles/file/libro%20de%20actas/CORRECTES/Panell%204_v2.pdf},
  urllabel = {Paper (ESP)},
  abstract = {Las prestaciones socioeconómicas y las rentas mínimas de los distintos niveles administrativos pretenden garantizar un mínimo de ingresos para las personas y familias en riesgo de exclusión social. En muchas ocasiones, los umbrales de ingresos para acceder a estas prestaciones no tienen en cuenta la realidad socioeconómica del territorio donde viven las personas y no permiten cubrir las necesidades básicas para tener una vida digna. Por este motivo, en este estudio se propone el cálculo de un indicador del coste de vida local que puede ayudar a abordar mejor los problemas de pobreza y garantía de ingresos a nivel local dado que estima un umbral absoluto por debajo del cual se entra en riesgo de pobreza, independientemente de la renta del resto de la ciudadanía. En concreto, se propone el indicador del "salario de referencia”, que tiene por objetivo principal establecer cuál sería la remuneración suficiente para que uno/a trabajador/a y su familia puedan vivir dignamente. Finalmente, este artículo muestra una aplicación de esta metodología en un caso real desarrollado para un ente local.},
}

