@unpublished{taberner_wip_gender_alignment,
  author = {Taberner, Pere A.},
  title = {The impact of teacher-student gender alignment on performance: evidence from higher education},
  note = {Work in progress, with D. Montolio},
  abstract = {Despite the vast number of studies analysing the impact of teacher gender on student performance, there is no conclusion about the question, since results are mixed: there is no impact, girls obtain better grades with female instructors or there is gender alignment, i.e. boys obtain better grades with male teachers and girls with female teachers. Moreover, almost all this literature is focused on students at primary school, secondary school or high school level and, to the best of our knowledge, there is only one study which analyses this question with university students. In the present paper we seek to assess the impact of teacher gender on students’ grades when sitting a final exam at university level. More precisely, we analyse the impact of the interaction of teacher-student gender on student performance.},
}

@unpublished{taberner_wip_educational_programs,
  author = {Taberner, Pere A.},
  title = {Impact of two innovative educational programs on student performance: experimental evidence from Spain},
  note = {Work in progress, with C. Blanco, M. Sánchez-Vidal and P. Salinas},
  abstract = {This paper presents an evaluation of two educational programs aimed at improving language and science skills of students in the last years of primary education. For this purpose, a stratified randomization analysis is carried out in 31 schools distributed among Aragon, Catalonia and the Community of Madrid, where a series of treated and control schools are defined. The results show an improvement in science skills after participation in the program. When the program is implemented by more than 40\%, the average scores of the treatment group increase up to 3 points out of 100. However, no impact is found in communication skills. The heterogeneity analysis shows that both programs have very positive effects on children with lower qualifications before participating in the program, which is a key element in the reduction of educational gaps among children.},
}

